# ============================================================
# Konfigurasi Sistem Nilai (Zero Trust)
# Salin ke ".env" dengan perintah:  npm run setup
# Nilai di bawah HANYA untuk demo lokal. Jangan dipakai di produksi.
# File .env tidak boleh di-commit (sudah ada di .gitignore).
# ============================================================

# Secret untuk menandatangani & memverifikasi JWT (HS256)
JWT_SECRET=demo-jwt-secret-ganti-di-lingkungan-nyata-0123456789abcdef
# Secret yang ditambahkan Gateway ke header X-Gateway-Secret
GATEWAY_SECRET=demo-gateway-secret-ganti-di-lingkungan-nyata-fedcba9876543210

# Kredensial Service Nilai untuk meminta token service (POST /auth/service)
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=demo-service-nilai-secret

# Port & alamat
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002
GATEWAY_URL=http://127.0.0.1:3000
NILAI_URL=http://127.0.0.1:3001
TRANSKRIP_URL=http://127.0.0.1:3002

# Database SQLite bersama (relatif terhadap folder proyek)
DB_PATH=database/nilai.db

# Jam akses ubah/finalisasi nilai (format HH:MM, 24 jam)
# Rentang berlaku mulai ACCESS_START sampai SEBELUM ACCESS_END.
# Waktu dihitung berdasarkan ACCESS_TIMEZONE, bukan jam zona laptop.
# Setelah mengubah nilai ini, restart Gateway DAN Service Nilai.
ACCESS_START=07:00
ACCESS_END=21:00
ACCESS_TIMEZONE=Asia/Jakarta
